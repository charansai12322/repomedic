# ==============================================================================
# RepoMedic Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit real credentials, tokens, or API keys to version control.
# ==============================================================================

# Application Environment (development, staging, production)
REPOMEDIC_ENV=development

# Server Binding
REPOMEDIC_HOST=127.0.0.1
REPOMEDIC_PORT=8000

# API Security
# In production, set a strong, random API key.
# In development, leave blank to permit unauthenticated local requests with a warning.
REPOMEDIC_API_KEY=

# CORS Allowed Origins (comma-separated list; do not use wildcard '*' in production)
REPOMEDIC_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Groq Cloud AI Inference (Optional; pipeline falls back to deterministic-only mode if omitted)
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TIMEOUT_SECONDS=30.0

# Concurrency and Resource Limits
REPOMEDIC_MAX_CONCURRENT_SCANS=2
REPOMEDIC_MAX_QUEUE_CAPACITY=20
REPOMEDIC_SCAN_TIMEOUT_SECONDS=300
REPOMEDIC_MAX_REPO_MB=250
REPOMEDIC_MAX_REPO_FILES=5000
REPOMEDIC_MAX_TEXT_FILE_BYTES=400000

# Scanner Policies (true = failure marks audit as partial/failed; false = optional)
REPOMEDIC_SEMGREP_REQUIRED=false
REPOMEDIC_OSV_REQUIRED=true
REPOMEDIC_CUSTOM_RULES_REQUIRED=true
REPOMEDIC_PYTHON_AST_REQUIRED=true
REPOMEDIC_AI_TRIAGE_REQUIRED=false
